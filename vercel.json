{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/_nitro/(.*)",
      "dest": "/_nitro/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*).(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
